{
  "expo": {
    "name": "SiklusFit",
    "slug": "siklusfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "siklusfit",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.siklusfit.app",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#F7F3EF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "SiklusFit memakai foto makanan untuk estimasi nutrisi lokal."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
